# Vektor2 intentionally keeps the application object graph small. The library
# list below is explicit enough to document the intended dependency boundary,
# while still including common transitive support needed by AHRS/EKF3/GCS.

def build(bld):
    # SITL enables custom control at board configure time. Vektor2 has no
    # custom controller, and duplicate command-line defines fail under -Werror.
    bld.env.DEFINES = [d for d in bld.env.DEFINES
                       if not d.startswith('AP_CUSTOMCONTROL_ENABLED=')]
    bld.env.CXXFLAGS = [f for f in bld.env.CXXFLAGS
                        if not f.startswith('-DHAL_NAVEKF2_AVAILABLE=')]
    # These are application-level exclusions, not runtime state machines.
    # They keep the generic GCS/AHRS libraries from pulling vehicle concepts
    # into Vektor2 while leaving EKF3, GPS, RCProtocol and MAVLink enabled.
    bld.env.DEFINES += [
        'AP_ARMING_ENABLED=0',
        'AP_MISSION_ENABLED=0',
        'AP_VEHICLE_ENABLED=0',
        'HAL_GCS_ENABLED=1',
        'COMPASS_LEARN_ENABLED=0',
        'COMPASS_MOT_ENABLED=0',
        'AP_SCRIPTING_ENABLED=0',
        'AP_SCRIPTING_SERIALDEVICE_ENABLED=0',
        'HAL_LOGGING_ENABLED=0',
        'AP_RC_CHANNEL_ENABLED=0',
        'AP_CAMERA_ENABLED=0',
        'AP_AIRSPEED_ENABLED=0',
        'AP_BATTERY_ENABLED=0',
        'AP_FENCE_ENABLED=0',
        'HAL_RALLY_ENABLED=0',
        'HAL_ADSB_ENABLED=0',
        'AP_AIS_ENABLED=0',
        'AP_OPTICALFLOW_ENABLED=0',
        'HAL_VISUALODOM_ENABLED=0',
        'AP_RANGEFINDER_ENABLED=0',
        'HAL_PROXIMITY_ENABLED=0',
        'HAL_MOUNT_ENABLED=0',
        'AP_TERRAIN_AVAILABLE=0',
        'AP_RPM_ENABLED=0',
        'HAL_WITH_ESC_TELEM=0',
        'HAL_GENERATOR_ENABLED=0',
        'AP_VIDEOTX_ENABLED=0',
        'AP_FRSKY_TELEM_ENABLED=0',
        'HAL_SPEKTRUM_TELEM_ENABLED=0',
        'AP_SERVORELAYEVENTS_ENABLED=0',
        'AP_ADVANCEDFAILSAFE_ENABLED=0',
        'AP_GRIPPER_ENABLED=0',
        'HAL_SPRAYER_ENABLED=0',
        'HAL_CANMANAGER_ENABLED=0',
        'HAL_MAX_CAN_PROTOCOL_DRIVERS=0',
        'HAL_ENABLE_DRONECAN_DRIVERS=0',
        'AP_CUSTOMROTATIONS_ENABLED=0',
        'AP_CUSTOMCONTROL_ENABLED=0',
        'HAL_NAVEKF2_AVAILABLE=0',
        'HAL_EFI_ENABLED=0',
        'HAL_GYROFFT_ENABLED=0',
        'AP_RELAY_ENABLED=0',
        'OSD_PARAM_ENABLED=0',
        'AP_GHST_TELEM_ENABLED=0',
        'AP_RSSI_ENABLED=0',
        'AP_BEACON_ENABLED=0',
        'AP_FETTEC_ONEWIRE_ENABLED=0',
        'AP_VOLZ_ENABLED=0',
        'AP_ROBOTISSERVO_ENABLED=0',
        'AP_SBUSOUTPUT_ENABLED=0',
        'AP_LTM_TELEM_ENABLED=0',
        'OSD_ENABLED=0',
        'AP_BARO_ENABLED=0',
        'AP_EXTERNAL_AHRS_ENABLED=0',
        'AP_AHRS_DCM_ENABLED=0',
        'HAL_WITH_FRSKY_TELEM_BIDIRECTIONAL=0',
    ]

    # Keep the application dependency list independent of flight vehicles.
    libraries = [
        'AP_Common',
        'AP_HAL',
        'AP_HAL_Empty',
        'AP_Math',
        'AP_Param',
        'StorageManager',
        'AP_BoardConfig',
        'AP_InternalError',
        'Filter',
        'AP_AccelCal',
        'AP_InertialSensor',
        'AP_NavEKF',
        'AP_NavEKF3',
        'AP_AHRS',
        'AP_GPS',
        'AP_SerialManager',
        'AP_RCProtocol',
        'GCS_MAVLink',
        'SRV_Channel',
        # AHRS/GCS compile-time references are feature-gated, but these small
        # support libraries keep the target compatible with normal ChibiOS
        # board configurations without instantiating vehicle subsystems.
        'AP_Compass',
        'AP_Baro',
        'AP_RTC',
        'AP_Filesystem',
        'AP_FlashStorage',
        'AP_RAMTRON',
        'AP_ROMFS',
        'AP_Scheduler',
        'AP_Module',
        'AP_WheelEncoder',
        'AP_Notify',
        'AP_DAL',
        'AP_Declination',
        'AP_GSOF',
        'AP_ESC_Telem',
        'AP_JSON',
    ]

    # Platform libraries are supplied by the selected board.
    board_libraries = bld.env.AP_LIBRARIES[:]
    for library in board_libraries:
        if library.startswith('AP_HAL_') and library not in libraries:
            libraries.append(library)

    bld.ap_stlib(
        name='Vektor2_libs',
        ap_vehicle='Vektor2',
        ap_libraries=libraries,
    )

    bld.ap_program(
        program_name='Vektor2',
        program_groups=['bin', 'vektor2'],
        use=['Vektor2_libs'],
    )

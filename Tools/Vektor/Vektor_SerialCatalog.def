                 "SYS_OPTIONS", I32, PROTOCOL, "sys_options", "System Options",
                 "", parameter_live_flags, 0, INT32_MAX, 0, SYS_OPTIONS)
VEKTOR_PARAMETER(SYS_DESC_PAGE, "component/system/0/parameter/sys_desc_page",
                 "SYS_DESC_PAGE", I16, PROTOCOL, "sys_desc_page",
                 "Descriptor Page Size", "records", parameter_live_flags,
                 Vektor::min_describe_page_records,
                 Vektor::max_describe_page_records,
                 Vektor::default_describe_page_records, SYS_DESC_PAGE)
VEKTOR_PARAMETER(USB_MODE, "component/system/0/parameter/usb_mode",

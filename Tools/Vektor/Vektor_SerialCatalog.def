/*
 * Canonical descriptor and programming-binding manifest.
 *
 * Include sites define the five VEKTOR_* macros to generate firmware schema
 * descriptors, strongly named C++ bindings, and complete lookup tables.
 */

VEKTOR_COMPONENT(PROTOCOL, "component/system/0",
                 "component_type/system/protocol", "protocol", "Protocol", 0, 0)
VEKTOR_COMPONENT(RUNTIME, "component/system/1",
                 "component_type/system/runtime", "runtime", "Runtime", 1, 0)
VEKTOR_COMPONENT(ATTITUDE, "component/attitude/0",
                 "component_type/sensor/attitude", "attitude0", "Attitude", 0, 0)
VEKTOR_COMPONENT(VSP, "component/vsp/1",
                 "component_type/control/vsp", "vsp1", "VSP 1", 1, 0)
VEKTOR_COMPONENT(RCIN, "component/rcin/0",
                 "component_type/input/rcin", "rcin0", "RC Input", 0, 0)
VEKTOR_COMPONENT(PWM_INPUT, "component/pwm_input/0",
                 "component_type/input/pwm", "pwmin0", "PWM Input", 0, 0)
VEKTOR_COMPONENT(PWM_OUTPUT, "component/pwm_output/0",
                 "component_type/output/pwm", "pwmout0", "PWM Output", 0, 0)

VEKTOR_OBSERVABLE(RX_FRAMES, "component/system/0/observable/rx_frames",
                  U32, PROTOCOL, "rx_frames", "RX Frames", "",
                  realtime_flags, RX_FRAMES)

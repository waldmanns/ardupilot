                  BOOL, PROTOCOL, "usb_reboot_required",
                  "USB Reboot Required", "bool", realtime_flags,
                  USB_REBOOT_REQUIRED)

#define VEKTOR_SERIAL_ENDPOINT_BINDINGS(INDEX)                              \
    VEKTOR_PARAMETER(SERIAL_##INDEX##_ROLE,                                 \
                     "component/system/0/parameter/serial_" #INDEX         \
                     "_role", "SER" #INDEX "_ROLE", ENUM, PROTOCOL,      \
                     "serial_" #INDEX "_role", "Serial " #INDEX         \
                     " Role", "role", parameter_reboot_flags, 0, 4, 0,    \
                     SERIAL_##INDEX##_ROLE)                                 \
    VEKTOR_PARAMETER(SERIAL_##INDEX##_BAUD,                                 \
                     "component/system/0/parameter/serial_" #INDEX         \
                     "_baud", "SER" #INDEX "_BAUD", I32, PROTOCOL,      \
                     "serial_" #INDEX "_baud", "Serial " #INDEX         \
                     " Baud", "baud", parameter_reboot_flags,             \
                     Vektor::protocol_baud_min, Vektor::protocol_baud_max,  \
                     Vektor::protocol_baud, SERIAL_##INDEX##_BAUD)          \
    VEKTOR_OBSERVABLE(SERIAL_##INDEX##_ACTIVE_ROLE,                         \
                      "component/system/0/observable/serial_" #INDEX       \
                      "_active_role", ENUM, PROTOCOL,                      \
                      "serial_" #INDEX "_active_role",                    \
                      "Serial " #INDEX " Active Role", "role",           \
                      realtime_flags, SERIAL_##INDEX##_ACTIVE_ROLE)         \
    VEKTOR_OBSERVABLE(SERIAL_##INDEX##_STATUS,                              \
                      "component/system/0/observable/serial_" #INDEX       \
                      "_status", ENUM, PROTOCOL,                           \
                      "serial_" #INDEX "_status",                         \
                      "Serial " #INDEX " Status", "status",              \
                      realtime_flags, SERIAL_##INDEX##_STATUS)              \
    VEKTOR_OBSERVABLE(SERIAL_##INDEX##_REBOOT_REQUIRED,                     \
                      "component/system/0/observable/serial_" #INDEX       \
                      "_reboot_required", BOOL, PROTOCOL,                  \
                      "serial_" #INDEX "_reboot_required",                \
                      "Serial " #INDEX " Reboot Required", "bool",       \
                      realtime_flags, SERIAL_##INDEX##_REBOOT_REQUIRED)

VEKTOR_SERIAL_ENDPOINT_BINDINGS(0)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(1)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(2)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(3)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(4)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(5)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(6)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(7)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(8)
VEKTOR_SERIAL_ENDPOINT_BINDINGS(9)
#undef VEKTOR_SERIAL_ENDPOINT_BINDINGS


# Vektor Core EVO -- conservative USB ArduPilot bootloader
# Hardware authority: vektor-core-evo(20261031-140802).kicad_sch
MCU STM32H7xx STM32H743xx
# Local testing ID only; must match application and receive allocation.
APJ_BOARD_ID 7198
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# USB FS only for predictable first programming and recovery.
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Keep two BMI088 chip-selects and SPI-card chip-select deselected.
PE4 BMI088_A_CS CS
PC13 BMI088_G_CS CS
PA15 SDCARD_CS CS

# MCU LED: active-high.
PA10 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1

# No bootloader SD flashing: the socket is SPI3, not SDMMC.
# U5 NAND is intentionally not accessed; its CS is not MCU-connected.

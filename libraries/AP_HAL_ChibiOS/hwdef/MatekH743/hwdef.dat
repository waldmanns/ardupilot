# hw definition file for processing by chibios_pins.py
# for Matek H743-WING

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_MATEKH743

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader takes first sector
FLASH_RESERVE_START_KB 128


# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 for IMU1 (MPU6000)
PA5 SPI1_SCK SPI1
PB4 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1

PA9 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC1 SPI2_MOSI SPI2



# two I2C bus
I2C_ORDER I2C1 I2C2 

# I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# ADC
PA7 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PA3 BATT_CURRENT_SENS ADC1 SCALE(1)


define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 31
define HAL_BATT_CURR_PIN 25
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 40.0



# LED
# green LED1 marked as B/E
# blue LED0 marked as ACT
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PC4 LED0 OUTPUT LOW GPIO(32) # blue
PC5 LED1 OUTPUT LOW GPIO(33) # green
define HAL_GPIO_A_LED_PIN 32
define HAL_GPIO_B_LED_PIN 33

# order of UARTs (and USB)
SERIAL_ORDER OTG1  USART1 USART2 OTG2

# USART1 (telem2)
PB15 USART1_RX USART1
PB14 USART1_TX USART1

# USART2 (GPS1)
PD5 USART2_TX USART2
PD6 USART2_RX USART2



# CAN bus
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

# Motors


# Beeper

# microSD support

# GPIOs

DMA_PRIORITY S*

define HAL_STORAGE_SIZE 32768

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 14

# spi devices
# SPI devices
SPIDEV  bmi088_a  SPI2  DEVID1  BMI088_A_CS  MODE3  10*MHZ 10*MHZ
SPIDEV  bmi088_g  SPI2  DEVID2  BMI088_G_CS  MODE3  10*MHZ 10*MHZ


PA4 SDCARD1_CS CS
SPIDEV sdcard SPI1 DEVID1 SDCARD1_CS  MODE0 400*KHZ 25*MHZ

DMA_NOSHARE SPI1* SPI2*


# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
define HAL_PROBE_EXTERNAL_I2C_COMPASS 1
define HAL_CUSTOM_HAL_I2C_DEVICES 1


# IMU
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_PITCH_180
PD13  BMI088_G_CS     CS
PA8  BMI088_A_CS     CS
PD14 DRDY1_BMI088_G  INPUT
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# DPS310 integrated on I2C2 bus, multiple possible choices for external barometer

BARO DPS310 I2C:1:0x77


define HAL_OS_FATFS_IO 1

# setup for OSD
define OSD_ENABLED 0


# build ABIN for flash-from-bootloader support:
env BUILD_ABIN True